  testFileCount          Int                    @default(0)
  supportFileCount       Int                    @default(0)
  discoveredTestCount    Int                    @default(0)
  limitations            String[]               @default([])
  failureCode            String?                @db.VarChar(100)
  requestedByUserId      String                 @db.Uuid
  startedAt              DateTime               @default(now()) @db.Timestamptz(3)
