generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ProjectMembershipRole {
  PROJECT_LEAD
  MEMBER
  VIEWER
}

enum ProjectMembershipStatus {
  ACTIVE
  REMOVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum RequirementSource {
  MANUAL
  IMPORTED
  AI_SUGGESTED
}

enum AiRunType {
  REQUIREMENT_REVIEW
}

enum AiRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiSuggestionCategory {
  AMBIGUITY
  MISSING_ACCEPTANCE_CRITERIA
  CONFLICT
  TESTABILITY
  EDGE_CASE
  UNANSWERED_QUESTION
}

enum AiSuggestionSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AiSuggestionStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

enum TestCaseStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum TestCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestCaseType {
  FUNCTIONAL
  END_TO_END
  API
  INTEGRATION
  REGRESSION
}

enum TestCaseSource {
  MANUAL
  IMPORTED
  AI_SUGGESTED
}

enum AutomationStatus {
  MANUAL
  CANDIDATE
  DRAFT
  AUTOMATED
}

enum AutomationEngine {
  PLAYWRIGHT_BROWSER
  PLAYWRIGHT_API
}

enum AutomationArtifactStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum AutomationValidationStatus {
  PASSED
  WARNINGS
  BLOCKED
}

enum TestRunStatus {
  NOT_STARTED
  PASSED
  FAILED
  BLOCKED
  CANCELED
}

enum TestRunResult {
  PASSED
  FAILED
  BLOCKED
}

enum TestRunMode {
  MANUAL
  PLAYWRIGHT_BROWSER
  API
}

enum TestEnvironment {
  LOCAL
  DEVELOPMENT
  STAGING
  PRODUCTION
  OTHER
}

enum TestBrowser {
  NONE
  CHROMIUM
  FIREFOX
  WEBKIT
}

enum FailureCategory {
  PRODUCT_DEFECT
  TEST_DEFECT
  ENVIRONMENT
  TEST_DATA
  DEPENDENCY
  FLAKY_TIMING
  UNKNOWN
}

enum FailureFindingStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

enum GitHubInstallationStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum GitHubWebhookDeliveryResult {
  APPLIED
  IGNORED
}

enum RepositoryConnectionStatus {
  ACTIVE
  ACCESS_REMOVED
  DISCONNECTED
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
  UNKNOWN
}

enum RepositoryImportStatus {
  RUNNING
  SUCCEEDED
  INCOMPLETE
  FAILED
}

enum RepositoryImportFileKind {
  PLAYWRIGHT_CONFIG
  TEST_SPEC
  SUPPORT_FILE
}

enum BillingPlan {
  FREE
  TEAM
}

enum BillingSubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum BillingEntitlementSource {
  SUBSCRIPTION
  MANUAL_OVERRIDE
}

enum StripeWebhookDeliveryResult {
  APPLIED
  IGNORED
}

enum ActivityAction {
  ORGANIZATION_UPDATED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_REMOVED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  PROJECT_MEMBER_ASSIGNED
  PROJECT_MEMBER_ROLE_CHANGED
  PROJECT_MEMBER_REMOVED
  REQUIREMENT_CREATED
  REQUIREMENT_UPDATED
  REQUIREMENT_SUBMITTED_FOR_REVIEW
  REQUIREMENT_CHANGES_REQUESTED
  REQUIREMENT_APPROVED
  REQUIREMENT_ARCHIVED
  REQUIREMENT_REVIEW_COMPLETED
  AI_SUGGESTION_ACCEPTED
  AI_SUGGESTION_DISMISSED
  TEST_CASE_CREATED
  TEST_CASE_UPDATED
  TEST_CASE_SUBMITTED_FOR_REVIEW
  TEST_CASE_CHANGES_REQUESTED
  TEST_CASE_APPROVED
  TEST_CASE_ARCHIVED
  TEST_CASE_REQUIREMENT_LINKED
  TEST_CASE_REQUIREMENT_UNLINKED
  TEST_RUN_CREATED
  TEST_RUN_ATTEMPT_RECORDED
  TEST_RUN_CANCELED
  FAILURE_ANALYSIS_COMPLETED
  FAILURE_FINDING_CONFIRMED
  FAILURE_FINDING_DISMISSED
  AUTOMATION_ARTIFACT_CREATED
  AUTOMATION_VERSION_GENERATED
  AUTOMATION_SUBMITTED_FOR_REVIEW
  AUTOMATION_CHANGES_REQUESTED
  AUTOMATION_APPROVED
  GITHUB_INSTALLATION_CONNECTED
  GITHUB_INSTALLATION_STATUS_CHANGED
  REPOSITORY_CONNECTED
  REPOSITORY_ACCESS_CHANGED
  REPOSITORY_IMPORT_COMPLETED
  BILLING_SUBSCRIPTION_UPDATED
  BILLING_ENTITLEMENTS_UPDATED
}

enum ActivityTargetType {
  ORGANIZATION
  MEMBERSHIP
  PROJECT
  PROJECT_MEMBERSHIP
  REQUIREMENT
  AI_RUN
  AI_SUGGESTION
  TEST_CASE
  REQUIREMENT_TEST_CASE
  TEST_RUN
  TEST_RUN_ATTEMPT
  FAILURE_ANALYSIS
  FAILURE_FINDING
  AUTOMATION_ARTIFACT
  AUTOMATION_ARTIFACT_VERSION
  GITHUB_INSTALLATION
  REPOSITORY_CONNECTION
  REPOSITORY_IMPORT
  BILLING_SUBSCRIPTION
}

enum ActivitySource {
  USER
  CLERK_WEBHOOK
  GITHUB_WEBHOOK
  STRIPE_WEBHOOK
  SYSTEM
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  clerkUserId        String     @unique @db.VarChar(255)
  primaryEmail       String?    @db.VarChar(320)
  displayName        String?    @db.VarChar(200)
  avatarUrl          String?    @db.Text
  status             UserStatus @default(ACTIVE)
  clerkUpdatedAt     DateTime?  @db.Timestamptz(3)
  lastWebhookEventId String?    @db.VarChar(255)
  lastSyncedAt       DateTime   @default(now()) @db.Timestamptz(3)
  disabledAt         DateTime?  @db.Timestamptz(3)
  deletedAt          DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  memberships                  Membership[]
  projectsCreated              Project[]                   @relation("ProjectCreatedBy")
  projectsArchived             Project[]                   @relation("ProjectArchivedBy")
  activities                   Activity[]                  @relation("ActivityActor")
  requirementsCreated          Requirement[]               @relation("RequirementCreatedBy")
  requirementsOwned            Requirement[]               @relation("RequirementOwner")
  requirementVersionsCreated   RequirementVersion[]        @relation("RequirementVersionCreatedBy")
  requirementVersionsOwned     RequirementVersion[]        @relation("RequirementVersionOwner")
  aiRunsCreated                AiRun[]                     @relation("AiRunCreatedBy")
  aiSuggestionsResolved        AiSuggestion[]              @relation("AiSuggestionResolvedBy")
  testCasesCreated             TestCase[]                  @relation("TestCaseCreatedBy")
  testCasesOwned               TestCase[]                  @relation("TestCaseOwner")
  testCaseVersionsCreated      TestCaseVersion[]           @relation("TestCaseVersionCreatedBy")
  testCaseVersionsOwned        TestCaseVersion[]           @relation("TestCaseVersionOwner")
  requirementTestCasesCreated  RequirementTestCase[]       @relation("RequirementTestCaseCreatedBy")
  testRunsCreated              TestRun[]                   @relation("TestRunCreatedBy")
  testRunsCanceled             TestRun[]                   @relation("TestRunCanceledBy")
  testRunAttemptsExecuted      TestRunAttempt[]            @relation("TestRunAttemptExecutedBy")
  failureAnalysesCreated       FailureAnalysis[]           @relation("FailureAnalysisCreatedBy")
  failureFindingsResolved      FailureFinding[]            @relation("FailureFindingResolvedBy")
  automationArtifactsCreated   AutomationArtifact[]        @relation("AutomationArtifactCreatedBy")
  automationArtifactsApproved  AutomationArtifact[]        @relation("AutomationArtifactApprovedBy")
  automationVersionsCreated    AutomationArtifactVersion[] @relation("AutomationArtifactVersionCreatedBy")
  githubInstallationsConnected GitHubInstallation[]        @relation("GitHubInstallationConnectedBy")
  repositoryConnectionsCreated RepositoryConnection[]      @relation("RepositoryConnectionCreatedBy")
  repositoryImportsRequested   RepositoryImport[]          @relation("RepositoryImportRequestedBy")

  @@index([primaryEmail])
  @@index([status])
}

model Organization {
  id                  String             @id @default(uuid()) @db.Uuid
  clerkOrganizationId String             @unique @db.VarChar(255)
  name                String             @db.VarChar(200)
  slug                String             @unique @db.VarChar(100)
  status              OrganizationStatus @default(ACTIVE)
  clerkUpdatedAt      DateTime?          @db.Timestamptz(3)
  lastWebhookEventId  String?            @db.VarChar(255)
  lastSyncedAt        DateTime           @default(now()) @db.Timestamptz(3)
  archivedAt          DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  memberships             Membership[]
  projects                Project[]
  activities              Activity[]
  projectMemberships      ProjectMembership[]
  requirements            Requirement[]
  aiRuns                  AiRun[]
  aiSuggestions           AiSuggestion[]
  testCases               TestCase[]
  requirementTestCases    RequirementTestCase[]
  testRuns                TestRun[]
  testRunAttempts         TestRunAttempt[]
  failureAnalyses         FailureAnalysis[]
  failureFindings         FailureFinding[]
  automationArtifacts     AutomationArtifact[]
  automationVersions      AutomationArtifactVersion[]
  githubInstallations     GitHubInstallation[]
  githubWebhookDeliveries GitHubWebhookDelivery[]
  repositoryConnections   RepositoryConnection[]
  repositoryImports       RepositoryImport[]
  repositoryImportFiles   RepositoryImportFile[]
  billingAccount          OrganizationBillingAccount?
  billingSubscriptions    BillingSubscription[]
  billingEntitlements     OrganizationEntitlement[]
  stripeWebhookDeliveries StripeWebhookDelivery[]

  @@index([status])
}

model OrganizationBillingAccount {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @unique @db.Uuid
  stripeCustomerId String?  @unique @db.VarChar(255)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptions BillingSubscription[]

  @@index([stripeCustomerId])
}

model BillingSubscription {
  id                   String                    @id @default(uuid()) @db.Uuid
  organizationId       String                    @db.Uuid
  billingAccountId     String                    @db.Uuid
  stripeSubscriptionId String                    @unique @db.VarChar(255)
  stripePriceId        String                    @db.VarChar(255)
  plan                 BillingPlan
  status               BillingSubscriptionStatus
  quantity             Int                       @default(1)
  cancelAtPeriodEnd    Boolean                   @default(false)
  currentPeriodStart   DateTime?                 @db.Timestamptz(3)
  currentPeriodEnd     DateTime?                 @db.Timestamptz(3)
  trialEnd             DateTime?                 @db.Timestamptz(3)
  providerUpdatedAt    DateTime                  @db.Timestamptz(3)
  lastStripeEventId    String                    @db.VarChar(255)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)

  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingAccount    OrganizationBillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entitlements      OrganizationEntitlement[]
  webhookDeliveries StripeWebhookDelivery[]

  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([billingAccountId, status])
}

model OrganizationEntitlement {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @db.Uuid
  key                  String                   @db.VarChar(100)
  enabled              Boolean                  @default(false)
  limitValue           Int?
  source               BillingEntitlementSource
  sourceSubscriptionId String?                  @db.Uuid
  effectiveFrom        DateTime                 @default(now()) @db.Timestamptz(3)
  effectiveUntil       DateTime?                @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceSubscription BillingSubscription? @relation(fields: [organizationId, sourceSubscriptionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, key])
  @@index([organizationId, enabled, key])
  @@index([sourceSubscriptionId])
}

model StripeWebhookDelivery {
  id                    String                      @id @default(uuid()) @db.Uuid
  stripeEventId         String                      @unique @db.VarChar(255)
  payloadSha256         String                      @db.Char(64)
  eventType             String                      @db.VarChar(100)
  externalObjectId      String?                     @db.VarChar(255)
  livemode              Boolean
  organizationId        String?                     @db.Uuid
  billingSubscriptionId String?                     @db.Uuid
  result                StripeWebhookDeliveryResult
  processedAt           DateTime                    @default(now()) @db.Timestamptz(3)

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscription BillingSubscription? @relation(fields: [organizationId, billingSubscriptionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, processedAt])
  @@index([billingSubscriptionId, processedAt])
  @@index([eventType, processedAt])
}

model Membership {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  userId             String           @db.Uuid
  clerkMembershipId  String?          @unique @db.VarChar(255)
  clerkRole          String?          @db.VarChar(100)
  role               MembershipRole
  status             MembershipStatus @default(ACTIVE)
  clerkUpdatedAt     DateTime?        @db.Timestamptz(3)
  lastWebhookEventId String?          @db.VarChar(255)
  lastSyncedAt       DateTime         @default(now()) @db.Timestamptz(3)
  removedAt          DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projectMemberships ProjectMembership[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  name             String        @db.VarChar(200)
  slug             String        @db.VarChar(100)
  description      String?       @db.Text
  status           ProjectStatus @default(ACTIVE)
  createdByUserId  String        @db.Uuid
  archivedByUserId String?       @db.Uuid
  archivedAt       DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy             User                        @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  archivedBy            User?                       @relation("ProjectArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projectMemberships    ProjectMembership[]
  activities            Activity[]
  requirements          Requirement[]
  aiRuns                AiRun[]
  aiSuggestions         AiSuggestion[]
  testCases             TestCase[]
  requirementTestCases  RequirementTestCase[]
  testRuns              TestRun[]
  testRunAttempts       TestRunAttempt[]
  failureAnalyses       FailureAnalysis[]
  failureFindings       FailureFinding[]
  automationArtifacts   AutomationArtifact[]
  automationVersions    AutomationArtifactVersion[]
  repositoryConnections RepositoryConnection[]
  repositoryImports     RepositoryImport[]
  repositoryImportFiles RepositoryImportFile[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId, status, updatedAt])
}

model ProjectMembership {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  projectId      String                  @db.Uuid
  userId         String                  @db.Uuid
  role           ProjectMembershipRole
  status         ProjectMembershipStatus @default(ACTIVE)
  removedAt      DateTime?               @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  membership   Membership   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, projectId, userId])
  @@index([organizationId, userId, status])
  @@index([projectId, role, status])
}

model Requirement {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @db.Uuid
  projectId            String            @db.Uuid
  title                String            @db.VarChar(300)
  description          String            @db.Text
  acceptanceCriteria   String            @db.Text
  status               RequirementStatus @default(DRAFT)
  source               RequirementSource @default(MANUAL)
  externalReference    String?           @db.VarChar(500)
  ownerUserId          String            @db.Uuid
  createdByUserId      String            @db.Uuid
  currentVersionNumber Int               @default(1)
  submittedForReviewAt DateTime?         @db.Timestamptz(3)
  approvedAt           DateTime?         @db.Timestamptz(3)
  archivedAt           DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project       Project               @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  owner         User                  @relation("RequirementOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User                  @relation("RequirementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions      RequirementVersion[]
  aiRuns        AiRun[]
  aiSuggestions AiSuggestion[]
  testCaseLinks RequirementTestCase[]

  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, status, updatedAt])
  @@index([ownerUserId, status])
}

model RequirementVersion {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  projectId          String            @db.Uuid
  requirementId      String            @db.Uuid
  versionNumber      Int
  title              String            @db.VarChar(300)
  description        String            @db.Text
  acceptanceCriteria String            @db.Text
  source             RequirementSource
  externalReference  String?           @db.VarChar(500)
  ownerUserId        String            @db.Uuid
  createdByUserId    String            @db.Uuid
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)

  requirement   Requirement    @relation(fields: [organizationId, projectId, requirementId], references: [organizationId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  owner         User           @relation("RequirementVersionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User           @relation("RequirementVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  aiRuns        AiRun[]
  aiSuggestions AiSuggestion[]

  @@unique([organizationId, projectId, requirementId, versionNumber])
  @@unique([organizationId, projectId, requirementId, id])
  @@index([requirementId, createdAt])
}

model AiRun {
  id                   String      @id @default(uuid()) @db.Uuid
  organizationId       String      @db.Uuid
  projectId            String      @db.Uuid
  requirementId        String      @db.Uuid
  requirementVersionId String      @db.Uuid
  type                 AiRunType
  status               AiRunStatus @default(RUNNING)
  model                String      @db.VarChar(100)
  promptVersion        String      @db.VarChar(100)
  schemaVersion        String      @db.VarChar(100)
  summary              String?     @db.Text
  inputTokens          Int?
  outputTokens         Int?
  totalTokens          Int?
  failureCode          String?     @db.VarChar(100)
  createdByUserId      String      @db.Uuid
  startedAt            DateTime    @default(now()) @db.Timestamptz(3)
  completedAt          DateTime?   @db.Timestamptz(3)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project            Project            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requirement        Requirement        @relation(fields: [organizationId, projectId, requirementId], references: [organizationId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  requirementVersion RequirementVersion @relation(fields: [organizationId, projectId, requirementId, requirementVersionId], references: [organizationId, projectId, requirementId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy          User               @relation("AiRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  suggestions        AiSuggestion[]

  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, requirementId, startedAt])
  @@index([status, startedAt])
}

model AiSuggestion {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  projectId            String               @db.Uuid
  requirementId        String               @db.Uuid
  requirementVersionId String               @db.Uuid
  aiRunId              String               @db.Uuid
  category             AiSuggestionCategory
  severity             AiSuggestionSeverity
  title                String               @db.VarChar(300)
  observation          String               @db.Text
  evidenceField        String               @db.VarChar(100)
  evidenceQuote        String               @db.Text
  recommendation       String               @db.Text
  status               AiSuggestionStatus   @default(OPEN)
  resolvedByUserId     String?              @db.Uuid
  resolvedAt           DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project            Project            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requirement        Requirement        @relation(fields: [organizationId, projectId, requirementId], references: [organizationId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  requirementVersion RequirementVersion @relation(fields: [organizationId, projectId, requirementId, requirementVersionId], references: [organizationId, projectId, requirementId, id], onDelete: Restrict, onUpdate: Restrict)
  aiRun              AiRun              @relation(fields: [organizationId, projectId, aiRunId], references: [organizationId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy         User?              @relation("AiSuggestionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, projectId, requirementId, status])
  @@index([aiRunId, createdAt])
}

model TestCase {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  projectId            String           @db.Uuid
  title                String           @db.VarChar(300)
  objective            String           @db.Text
  preconditions        String           @db.Text
  steps                Json             @db.JsonB
  expectedResults      Json             @db.JsonB
  priority             TestCasePriority @default(MEDIUM)
  type                 TestCaseType     @default(FUNCTIONAL)
  status               TestCaseStatus   @default(DRAFT)
  source               TestCaseSource   @default(MANUAL)
  tags                 String[]         @default([])
  automationStatus     AutomationStatus @default(MANUAL)
  ownerUserId          String           @db.Uuid
  createdByUserId      String           @db.Uuid
  currentVersionNumber Int              @default(1)
  submittedForReviewAt DateTime?        @db.Timestamptz(3)
  approvedAt           DateTime?        @db.Timestamptz(3)
  archivedAt           DateTime?        @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

