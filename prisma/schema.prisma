model GitHubInstallation {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @db.Uuid
  externalInstallationId String                   @unique @db.VarChar(32)
  accountId              String                   @db.VarChar(32)
  accountLogin           String                   @db.VarChar(255)
  accountType            String                   @db.VarChar(50)
  repositorySelection    String                   @db.VarChar(20)
  status                 GitHubInstallationStatus @default(ACTIVE)
  connectedByUserId      String                   @db.Uuid
  installedAt            DateTime?                @db.Timestamptz(3)
  suspendedAt            DateTime?                @db.Timestamptz(3)
  removedAt              DateTime?                @db.Timestamptz(3)
  providerUpdatedAt      DateTime?                @db.Timestamptz(3)
  lastWebhookDeliveryId  String?                  @db.VarChar(128)
  lastSyncedAt           DateTime                 @default(now()) @db.Timestamptz(3)
