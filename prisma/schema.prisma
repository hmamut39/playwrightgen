model RepositoryConnection {
  id                   String                     @id @default(uuid()) @db.Uuid
  organizationId       String                     @db.Uuid
  projectId            String                     @db.Uuid
  githubInstallationId String                     @db.Uuid
  externalRepositoryId String                     @db.VarChar(32)
  ownerLogin           String                     @db.VarChar(255)
  name                 String                     @db.VarChar(255)
  fullName             String                     @db.VarChar(511)
  defaultBranch        String                     @db.VarChar(255)
  visibility           RepositoryVisibility       @default(UNKNOWN)
  status               RepositoryConnectionStatus @default(ACTIVE)
  createdByUserId      String                     @db.Uuid
  lastImportedAt       DateTime?                  @db.Timestamptz(3)
  accessRemovedAt      DateTime?                  @db.Timestamptz(3)
  disconnectedAt       DateTime?                  @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project      Project            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
